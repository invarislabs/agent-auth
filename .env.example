# Copy to .env and change every value marked CHANGE ME. Never commit .env.

# --- docker compose ---------------------------------------------------------
POSTGRES_PASSWORD=CHANGE-ME-long-random-password
REDIS_PASSWORD=CHANGE-ME-long-random-password

# --- registry ---------------------------------------------------------------
# The host[:port] clients put in their URLs (comma-separated). Behind a proxy
# on 443 this is just the host name, e.g. registry.example.com
AGENTAUTH_AUDIENCES=localhost:8000,127.0.0.1:8000

# Database: sqlite:////abs/path.db, sqlite:///relative.db or postgresql://user:pass@host/db
# AGENTAUTH_DATABASE_URL=sqlite:////data/agentauth.db

# Shared replay cache and rate limits for more than one worker/replica.
# AGENTAUTH_REDIS_URL=redis://:password@redis:6379/0

# Apply schema migrations at startup (true) or only via `agentauth db migrate` (false, recommended for prod).
# AGENTAUTH_AUTO_MIGRATE=true

# Number of reverse proxies in front of the registry whose X-Forwarded-For you trust (0 = ignore the header).
AGENTAUTH_TRUSTED_PROXY_HOPS=0

# Per-client-address limits, COUNT/SECONDS or "off".
AGENTAUTH_RATE_LIMIT_WRITES=60/60
AGENTAUTH_RATE_LIMIT_READS=1200/60

# Require this token (header X-AgentAuth-Registration-Token) to register new identities.
# At least 16 characters. Or use AGENTAUTH_REGISTRATION_TOKEN_FILE=/run/secrets/registration_token
# AGENTAUTH_REGISTRATION_TOKEN=

# AGENTAUTH_MAX_BODY_BYTES=16384
# AGENTAUTH_MAX_SKEW=120
# AGENTAUTH_RESOLVE_CACHE_SECONDS=30
# AGENTAUTH_METRICS=true
AGENTAUTH_LOG_LEVEL=INFO
AGENTAUTH_LOG_FORMAT=json

# --- agents and the CLI -----------------------------------------------------
# AGENTAUTH_REGISTRY=https://registry.example.com
# AGENTAUTH_HOME=~/.agentauth
# Encrypts key files. Prefer AGENTAUTH_PASSPHRASE_FILE pointing at a secret mount.
# AGENTAUTH_PASSPHRASE=
# AGENTAUTH_PASSPHRASE_FILE=
